TOGGL_API_TOKEN=your_toggl_api_token_here
TOGGL_WORKSPACE_ID=your_workspace_id

# How far back the one-time historical backfill reaches (default: 2006-01-01).
# Uses the Reports API, which has no ~90-day floor like the core API, so this
# can safely be set deep in the past — an empty 366-day chunk still only
# costs one request against the hourly quota.
# TOGGL_HISTORY_START_DATE=2006-01-01

# Recurring entry descriptions are detected automatically; exclude some (JSON list)
# TOGGL_IGNORED_DESCRIPTIONS=["Errands"]

# Apprise notification URL (for trend alerts)
APPRISE_URL=http://apprise:8000/notify/toggl
TREND_ALERT_THRESHOLD=0.25
